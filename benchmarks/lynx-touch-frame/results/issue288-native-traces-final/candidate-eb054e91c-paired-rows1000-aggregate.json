  "query": {
    "source": "file",
    "text": "WITH bounds AS (\n  SELECT\n    MIN(CASE WHEN name LIKE 'Issue288::%::mts-input' THEN ts END) AS start_ts,\n    MAX(CASE WHEN name LIKE 'Issue288::%::changed-vsync' THEN ts END) AS end_ts\n  FROM slice\n), window_slices AS (\n  SELECT s.*, t.name AS thread_name\n  FROM slice s\n  JOIN thread_track tt ON s.track_id = tt.id\n  JOIN thread t ON tt.utid = t.utid\n  CROSS JOIN bounds b\n  WHERE s.ts >= b.start_ts\n    AND s.ts <= b.end_ts\n    AND t.name IN ('Lynx_JS', 'm.lynx.explorer', 'RenderThread')\n)\nSELECT\n  thread_name,\n  name,\n  COUNT(*) AS count,\n  SUM(dur) / 1e6 AS total_ms,\n  MAX(dur) / 1e6 AS max_ms\nFROM window_slices\nGROUP BY thread_name, name\nHAVING SUM(dur) >= 1e6\nORDER BY total_ms DESC\nLIMIT 250;\n",
    "sha256": "e9bb493a01477bdd6a4d4c93424132a141bcb0894eeb2b785d399dd39c569820",
