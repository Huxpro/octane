    "source": "file",
    "text": "WITH bounds AS (\n  SELECT\n    MIN(CASE WHEN name LIKE 'Issue288::%::mts-input' THEN ts END) AS start_ts,\n    MAX(CASE WHEN name LIKE 'Issue288::%::changed-vsync' THEN ts END) AS end_ts\n  FROM slice\n)\nSELECT\n  s.id,\n  s.parent_id,\n  s.name,\n  s.ts / 1e6 AS ts_ms,\n  s.dur / 1e6 AS dur_ms,\n  t.name AS thread_name,\n  s.depth\nFROM slice s\nJOIN thread_track tt ON s.track_id = tt.id\nJOIN thread t ON tt.utid = t.utid\nCROSS JOIN bounds b\nWHERE s.ts >= b.start_ts\n  AND s.ts <= b.end_ts\n  AND s.dur >= 5e6\n  AND t.name IN ('Lynx_JS', 'm.lynx.explorer', 'RenderThread')\nORDER BY s.ts, s.depth;\n",
    "sha256": "0b3a3c111babf035a9088235dcfd1b28188fef0e68f021ccf95a40b3d8c9c6e8",
