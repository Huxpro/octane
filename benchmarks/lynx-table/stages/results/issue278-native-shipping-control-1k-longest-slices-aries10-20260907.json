    "source": "inline",
    "text": "WITH b AS (SELECT MIN(CASE WHEN name='Issue278::create-start' THEN ts END) AS start_ts, MAX(CASE WHEN name='Issue278::commit-ack' THEN ts END) AS end_ts FROM slice) SELECT s.id,s.name,ROUND(s.dur/1000000.0,3) AS dur_ms,th.name AS thread_name,p.name AS process_name,s.depth FROM slice s JOIN track t ON s.track_id=t.id LEFT JOIN thread_track tt ON t.id=tt.id LEFT JOIN thread th ON tt.utid=th.utid LEFT JOIN process p ON th.upid=p.upid,b WHERE s.ts>=b.start_ts AND s.ts<=b.end_ts AND s.dur>0 ORDER BY s.dur DESC LIMIT 100",
