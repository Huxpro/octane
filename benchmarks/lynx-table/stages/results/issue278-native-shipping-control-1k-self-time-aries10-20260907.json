  "query": {
    "source": "inline",
    "text": "WITH b AS (SELECT MIN(CASE WHEN name='Issue278::create-start' THEN ts END) start_ts,MAX(CASE WHEN name='Issue278::commit-ack' THEN ts END) end_ts FROM slice), child AS (SELECT parent_id,SUM(dur) child_dur FROM slice WHERE parent_id IS NOT NULL GROUP BY parent_id), x AS (SELECT s.name,s.track_id,s.dur-COALESCE(child.child_dur,0) self_dur FROM slice s LEFT JOIN child ON child.parent_id=s.id,b WHERE s.ts>=b.start_ts AND s.ts<=b.end_ts AND s.dur>0) SELECT x.name,th.name thread_name,COUNT(*) count,ROUND(SUM(x.self_dur)/1000000.0,3) self_ms,ROUND(SUM(x.self_dur)/COUNT(*)/1000000.0,6) avg_self_ms FROM x JOIN track t ON x.track_id=t.id LEFT JOIN thread_track tt ON t.id=tt.id LEFT JOIN thread th ON tt.utid=th.utid GROUP BY x.name,th.name ORDER BY SUM(x.self_dur) DESC LIMIT 100",
    "sha256": "a283b642789272c4d6d1a151a2208c95669128ec340dc822d3534540602d3945"
