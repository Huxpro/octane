    "source": "inline",
    "text": "WITH rt AS (SELECT clock_value - ts AS offset_ns FROM clock_snapshot WHERE clock_name = 'REALTIME' ORDER BY ts LIMIT 1) SELECT s.id, s.name, s.ts, s.dur, (s.ts + (SELECT offset_ns FROM rt)) / 1000000.0 AS realtime_start_ms, (s.ts + s.dur + (SELECT offset_ns FROM rt)) / 1000000.0 AS realtime_end_ms, t.name AS thread_name, p.name AS process_name, s.depth FROM slice s LEFT JOIN thread_track tt ON s.track_id = tt.id LEFT JOIN thread t ON tt.utid = t.utid LEFT JOIN process p ON t.upid = p.upid WHERE s.name IN ('Timing::Mark.mtsRenderStart','Timing::Mark.mtsRenderEnd','Timing::Mark.paintingUiOperationExecuteStart','Timing::Mark.paintingUiOperationExecuteEnd','FirstMeaningfulPaint','Client.onFirstScreen','AnimationFrameTaskHandler::DoFrame','AnimationFrameTaskHandler::RequestAnimationFrame','RequestAnimationFrame') ORDER BY s.ts",
